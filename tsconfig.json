{
  "extends": "@tsconfig/node12/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["*"]
    },
    "resolveJsonModule": true,
    "outDir": ".homeybuild/"
  },
  "exclude": [
    ".homeybuild",
    "assets/js/forecastModelSetup.js",
    "assets/js/locationSetup.js",
    "assets/js/weatherVariableSelector.js",
    "node_modules",
    "test"
  ]
}
