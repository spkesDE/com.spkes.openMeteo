{
  "title": {
    "en": "Get weather forecast in hours",
    "de": "Wettervorhersage in Stunden abrufen"
  },
  "titleFormatted": {
    "en": "Get weather in [[hours]] hour(s)",
    "de": "Wetter in [[hours]] Stunde(n) abrufen"
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=weather"
    },
    {
      "type": "number",
      "name": "hours",
      "required": true,
      "min": 0,
      "max": 360,
      "step": 1,
      "placeholder": {
        "en": "Hours (0-360)",
        "de": "Stunden (0-360)"
      },
      "title": {
        "en": "Hours ahead",
        "de": "Stunden im Voraus"
      }
    }
  ],
  "tokens": [
    {
      "name": "temperature",
      "type": "number",
      "title": {
        "en": "Temperature (°C)",
        "de": "Temperatur (°C)"
      }
    },
    {
      "name": "apparent_temperature",
      "type": "number",
      "title": {
        "en": "Apparent Temperature (°C)",
        "de": "Gefühlte Temperatur (°C)"
      }
    },
    {
      "name": "dewpoint",
      "type": "number",
      "title": {
        "en": "Dewpoint (°C)",
        "de": "Taupunkt (°C)"
      }
    },
    {
      "name": "weather_condition",
      "type": "string",
      "title": {
        "en": "Weather Condition",
        "de": "Wetterverhältnisse"
      }
    },
    {
      "name": "weather_code",
      "type": "number",
      "title": {
        "en": "Weather Code",
        "de": "Wettercode"
      }
    },
    {
      "name": "humidity",
      "type": "number",
      "title": {
        "en": "Relative Humidity (%)",
        "de": "Relative Luftfeuchtigkeit (%)"
      }
    },
    {
      "name": "precipitation_probability",
      "type": "number",
      "title": {
        "en": "Precipitation Probability (%)",
        "de": "Niederschlagswahrscheinlichkeit (%)"
      }
    },
    {
      "name": "precipitation",
      "type": "number",
      "title": {
        "en": "Precipitation",
        "de": "Niederschlag"
      }
    },
    {
      "name": "rain",
      "type": "number",
      "title": {
        "en": "Rain",
        "de": "Regen"
      }
    },
    {
      "name": "showers",
      "type": "number",
      "title": {
        "en": "Showers",
        "de": "Schauer"
      }
    },
    {
      "name": "snowfall",
      "type": "number",
      "title": {
        "en": "Snowfall",
        "de": "Schneefall"
      }
    },
    {
      "name": "cloudcover",
      "type": "number",
      "title": {
        "en": "Cloud cover (%)",
        "de": "Bewölkung (%)"
      }
    },
    {
      "name": "visibility",
      "type": "number",
      "title": {
        "en": "Visibility",
        "de": "Sichtweite"
      }
    },
    {
      "name": "pressure_msl",
      "type": "number",
      "title": {
        "en": "Sea Level Pressure (hPa)",
        "de": "Luftdruck auf Meereshöhe (hPa)"
      }
    },
    {
      "name": "wind_speed",
      "type": "number",
      "title": {
        "en": "Wind Speed",
        "de": "Windgeschwindigkeit"
      }
    },
    {
      "name": "wind_direction",
      "type": "number",
      "title": {
        "en": "Wind Direction (°)",
        "de": "Windrichtung (°)"
      }
    },
    {
      "name": "wind_gusts",
      "type": "number",
      "title": {
        "en": "Wind Gusts",
        "de": "Windböen"
      }
    },
    {
      "name": "temperature_min",
      "type": "number",
      "title": {
        "en": "Min Temperature (°C)",
        "de": "Mindesttemperatur (°C)"
      }
    },
    {
      "name": "temperature_max",
      "type": "number",
      "title": {
        "en": "Max Temperature (°C)",
        "de": "Höchsttemperatur (°C)"
      }
    },
    {
      "name": "apparent_temperature_min",
      "type": "number",
      "title": {
        "en": "Min Apparent Temperature (°C)",
        "de": "Minimale gefühlte Temperatur (°C)"
      }
    },
    {
      "name": "apparent_temperature_max",
      "type": "number",
      "title": {
        "en": "Max Apparent Temperature (°C)",
        "de": "Maximale gefühlte Temperatur (°C)"
      }
    },
    {
      "name": "precipitation_sum",
      "type": "number",
      "title": {
        "en": "Precipitation Sum",
        "de": "Niederschlagssumme"
      }
    },
    {
      "name": "uv_index_max",
      "type": "number",
      "title": {
        "en": "Max UV Index",
        "de": "UV-Index Maximum"
      }
    },
    {
      "name": "wind_gusts_max",
      "type": "number",
      "title": {
        "en": "Max Wind Gusts",
        "de": "Maximale Windböen"
      }
    },
    {
      "name": "sunrise",
      "type": "string",
      "title": {
        "en": "Sunrise (HH:MM)",
        "de": "Sonnenaufgang (HH:MM)"
      }
    },
    {
      "name": "sunset",
      "type": "string",
      "title": {
        "en": "Sunset (HH:MM)",
        "de": "Sonnenuntergang (HH:MM)"
      }
    }
  ]
}
